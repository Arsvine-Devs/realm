# Static service origins are defined in config/site-config.mjs.

# Core
# Local or self-hosted Realm listen port.
# Format: decimal TCP port, 1-65535
# Scope: local, self-hosted
PORT=3000

# Public
# Opt-in browser telemetry provider.
# Format: literal vercel or unset
# Scope: local, preview, production
# NEXT_PUBLIC_TELEMETRY_PROVIDER=vercel

# Content
# Server-only Realm client for protected Content reads.
# Format: OAuth client identifier registered by Auth
# Scope: local, preview, production
# CONTENT_SERVICE_CLIENT_ID=realm-content-reader
# Server-only credential paired with CONTENT_SERVICE_CLIENT_ID.
# Format: OAuth client secret registered by Auth
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# CONTENT_SERVICE_CLIENT_SECRET=replace-with-a-long-random-secret

# Security
# Signs the protected-post access grant cookie.
# Format: long random server-side signing secret
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# ACCESS_GRANT_SECRET=replace-with-a-random-long-string
# Server-only TOTP group configuration for protected posts.
# Format: JSON object map with current base32 secret and optional period/digits/window
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# TOTP_GROUPS_JSON={"friends-a":{"current":"JBSWY3DPEHPK3PXP","period":30,"digits":6,"window":1}}
# Authenticates internal Content and asset revalidation events.
# Format: long random HMAC secret shared with API and asset publisher
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# REVALIDATE_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Trusts forwarded client-IP headers behind a controlled reverse proxy.
# Format: boolean string: 1/0 or true/false
# Scope: local, self-hosted
# TRUST_PROXY=1
# Signs anonymous visitor-statistics cookies and database writes.
# Format: long random HMAC secret unique to Realm visitor statistics
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# VISITOR_STATS_SECRET=replace-with-a-random-long-string

# Infra
# Realm visitor-statistics database connection.
# Format: PostgreSQL connection URL, with TLS required for hosted databases
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Distributed rate-limit store endpoint.
# Format: absolute HTTPS Upstash REST URL
# Scope: local, preview, production
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# Distributed rate-limit store credential.
# Format: Upstash REST bearer token paired with the REST URL
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# UPSTASH_REDIS_REST_TOKEN=your-token
# Private bucket for server-side versioned Catalog and asset publication.
# Format: COS bucket name without protocol or slash
# Secret: keep this value in an untracked environment file.
# Scope: local, preview, production
# COS_PRIVATE_BUCKET=your-private-bucket
# Region for the private Catalog bucket.
# Format: Tencent COS region identifier
# Scope: local, preview, production
# COS_PRIVATE_REGION=ap-hongkong
# Public-media bucket target for the asset publisher.
# Format: COS bucket name without protocol or slash
# Secret: keep this value in an untracked environment file.
# Scope: local
# COS_PUBLIC_BUCKET=your-public-bucket
# Region for the public-media bucket.
# Format: Tencent COS region identifier
# Scope: local
# COS_PUBLIC_REGION=ap-hongkong
# Server-side COS/COSCLI credential identifier.
# Format: Tencent Cloud CAM SecretId
# Secret: keep this value in an untracked environment file.
# Scope: local
# COS_SECRET_ID=AKIDxxx
# Server-side COS/COSCLI credential secret.
# Format: Tencent Cloud CAM SecretKey
# Secret: keep this value in an untracked environment file.
# Scope: local
# COS_SECRET_KEY=xxxx
# Optional prefix before the Realm private Catalog namespace.
# Format: relative object-key prefix without leading/trailing slash
# Scope: local, preview, production
# COS_PRIVATE_CATALOG_PREFIX=

# Tweets Dev
# Enables synthetic Tweet archive data for development.
# Format: feature flag: 1 enables synthetic development data
# Scope: local
# TWEETS_STRESS_TEST=1
# Synthetic archive year count when stress mode is enabled.
# Format: positive decimal integer
# Scope: local
# TWEETS_STRESS_YEARS=6
# Synthetic archive months per year when stress mode is enabled.
# Format: positive decimal integer
# Scope: local
# TWEETS_STRESS_MONTHS_PER_YEAR=12
# Synthetic Tweet count per month when stress mode is enabled.
# Format: positive decimal integer
# Scope: local
# TWEETS_STRESS_TWEETS_PER_MONTH=24

# Advanced
# Enables the Next.js bundle analyzer for a local build.
# Format: literal true to enable bundle analyzer
# Scope: local
# ANALYZE=true
# Optional Next.js build output directory.
# Format: relative build directory path
# Scope: local, self-hosted
# NEXT_BUILD_DIR=.next
