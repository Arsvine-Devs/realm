{
  "version": 1,
  "entries": [
    {
      "key": "PORT",
      "section": "Core",
      "exampleFiles": [".env.example"],
      "commented": false,
      "requiredness": "optional",
      "secret": false,
      "format": "decimal TCP port, 1-65535",
      "example": "3000",
      "localDefault": "3000",
      "scopes": ["local", "self-hosted"],
      "usedBy": ["package.json"],
      "description": "Local or self-hosted Realm listen port.",
      "failureBehavior": "Defaults to 3000."
    },
    {
      "key": "CONTENT_SERVICE_CLIENT_ID",
      "section": "Content",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": false,
      "format": "OAuth client identifier registered by Auth",
      "example": "realm-content-reader",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Server-only Realm client for protected Content reads.",
      "failureBehavior": "Protected Content reads fail closed when absent."
    },
    {
      "key": "CONTENT_SERVICE_CLIENT_SECRET",
      "section": "Content",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "OAuth client secret registered by Auth",
      "example": "replace-with-a-long-random-secret",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Server-only credential paired with CONTENT_SERVICE_CLIENT_ID.",
      "failureBehavior": "Protected Content reads fail closed; never expose the value to the browser."
    },
    {
      "key": "ACCESS_GRANT_SECRET",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "long random server-side signing secret",
      "example": "replace-with-a-random-long-string",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/access-grant.ts"],
      "description": "Signs the protected-post access grant cookie.",
      "failureBehavior": "Grant creation and verification fail closed."
    },
    {
      "key": "TOTP_GROUPS_JSON",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "JSON object map with current base32 secret and optional period/digits/window",
      "example": "{\"friends-a\":{\"current\":\"JBSWY3DPEHPK3PXP\",\"period\":30,\"digits\":6,\"window\":1}}",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/totp.ts"],
      "description": "Server-only TOTP group configuration for protected posts.",
      "failureBehavior": "Invalid JSON is rejected; an unset map provides no configured groups."
    },
    {
      "key": "TRUST_PROXY",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "boolean string: 1/0 or true/false",
      "example": "1",
      "localDefault": "",
      "scopes": ["local", "self-hosted"],
      "usedBy": ["src/shared/server/http.ts"],
      "description": "Trusts forwarded client-IP headers behind a controlled reverse proxy.",
      "failureBehavior": "Forwarding and location headers are ignored unless the trusted ingress enables them."
    },
    {
      "key": "VISITOR_STATS_SECRET",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "long random HMAC secret unique to Realm visitor statistics",
      "example": "replace-with-a-random-long-string",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/features/visitor-stats/server/visitorStats.ts"],
      "description": "Signs anonymous visitor-statistics cookies and database writes.",
      "failureBehavior": "Visitor-statistics persistence is skipped when the secret is absent."
    },
    {
      "key": "REALM_CSP_SCRIPT_REPORT_ONLY",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "1 enables report-only diagnostics",
      "example": "1",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/proxy.ts"],
      "description": "Enables nonce-based script CSP diagnostics without blocking scripts.",
      "failureBehavior": "The standard Realm response security headers still apply."
    },
    {
      "key": "DATABASE_URL",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "PostgreSQL connection URL, with TLS required for hosted databases",
      "example": "postgresql://user:password@host/database?sslmode=require",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": [
        "src/features/visitor-stats/server/visitorStats.ts",
        "scripts/visitor-stats-migrate.mjs"
      ],
      "description": "Realm visitor-statistics database connection.",
      "failureBehavior": "Visitor-statistics persistence and database commands fail closed."
    },
    {
      "key": "TWEETS_STRESS_TEST",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "feature flag: 1 enables synthetic development data",
      "example": "1",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Enables synthetic Tweet archive data for development.",
      "failureBehavior": "Real published Content data is used."
    },
    {
      "key": "TWEETS_STRESS_YEARS",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "positive decimal integer",
      "example": "6",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Synthetic archive year count when stress mode is enabled.",
      "failureBehavior": "Defaults to 6."
    },
    {
      "key": "TWEETS_STRESS_MONTHS_PER_YEAR",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "positive decimal integer",
      "example": "12",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Synthetic archive months per year when stress mode is enabled.",
      "failureBehavior": "Defaults to 12."
    },
    {
      "key": "TWEETS_STRESS_TWEETS_PER_MONTH",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "positive decimal integer",
      "example": "24",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Synthetic Tweet count per month when stress mode is enabled.",
      "failureBehavior": "Defaults to 24."
    },
    {
      "key": "ANALYZE",
      "section": "Advanced",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "literal true to enable bundle analyzer",
      "example": "true",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["next.config.js"],
      "description": "Enables the Next.js bundle analyzer for a local build.",
      "failureBehavior": "The analyzer remains disabled."
    },
    {
      "key": "REDIS_URL",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": true,
      "format": "Redis TCP URL",
      "example": "redis://valkey:6379/2",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/rate-limit.ts"],
      "description": "Valkey connection for Realm rate limiting.",
      "failureBehavior": "Uses a process-local limiter when unavailable."
    },
    {
      "key": "AUTH_INTERNAL_ORIGIN",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "absolute HTTP(S) origin",
      "example": "http://127.0.0.1:12003",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Internal HTTP origin for exchanging protected-content tokens with Auth.",
      "failureBehavior": "Uses the public Auth origin when omitted."
    },
    {
      "key": "CONTENT_INTERNAL_ORIGIN",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "absolute HTTP(S) origin",
      "example": "http://content:3002",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Internal HTTP origin for Content server requests.",
      "failureBehavior": "Uses the stable public Content origin when omitted."
    },
    {
      "key": "REALM_CATALOG_ROOT",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": false,
      "format": "absolute path",
      "example": "/media-private",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/features/assets/server/catalog/catalog-provider.ts"],
      "description": "Read-only private media mount containing realm/catalog/versions.",
      "failureBehavior": "Catalog endpoints return service unavailable when missing."
    },
    {
      "key": "REALM_CATALOG_POINTER",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": false,
      "format": "absolute path",
      "example": "/media-private/realm/catalog/current.json",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/features/assets/server/catalog/catalog-provider.ts"],
      "description": "Read-only private Catalog pointer.",
      "failureBehavior": "Catalog endpoints return service unavailable when missing."
    },
    {
      "key": "ARSVINE_PUBLIC_MEDIA_ORIGIN",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "absolute HTTPS origin",
      "example": "https://cdn.arsvine.com",
      "localDefault": "",
      "scopes": ["production"],
      "usedBy": ["src/shared/lib/media.ts"],
      "description": "Public media origin registered by the Web gateway.",
      "failureBehavior": "Development and previews use same-origin media."
    },
    {
      "key": "REDIS_KEY_PREFIX",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "redis key namespace prefix",
      "example": "realm:production:",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/rate-limit.ts"],
      "description": "Valkey namespace for this deployment.",
      "failureBehavior": "Uses the production Realm namespace."
    },
    {
      "key": "AUTH_ORIGIN",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "absolute HTTPS origin",
      "example": "https://auth-preview.arsvine.com",
      "localDefault": "",
      "scopes": ["local", "preview"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Auth issuer used by an isolated preview.",
      "failureBehavior": "Uses the shared production origin when omitted."
    },
    {
      "key": "CONTENT_ORIGIN",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "absolute HTTPS origin",
      "example": "https://content-preview.arsvine.com",
      "localDefault": "",
      "scopes": ["local", "preview"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Public Content audience used by an isolated preview.",
      "failureBehavior": "Uses the shared production origin when omitted."
    }
  ]
}
