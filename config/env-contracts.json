{
  "version": 1,
  "entries": [
    {
      "key": "PORT",
      "section": "Core",
      "exampleFiles": [".env.example"],
      "commented": false,
      "requiredness": "optional",
      "secret": false,
      "format": "decimal TCP port, 1-65535",
      "example": "3000",
      "localDefault": "3000",
      "scopes": ["local", "self-hosted"],
      "usedBy": ["server.js"],
      "description": "Local or self-hosted Realm listen port.",
      "failureBehavior": "Defaults to 3000."
    },
    {
      "key": "NEXT_PUBLIC_TELEMETRY_PROVIDER",
      "section": "Public",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "literal vercel or unset",
      "example": "vercel",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/features/telemetry/ui/telemetry/TelemetryRoot.tsx"],
      "description": "Opt-in browser telemetry provider.",
      "failureBehavior": "Telemetry is not mounted when unset or unsupported."
    },
    {
      "key": "CONTENT_SERVICE_CLIENT_ID",
      "section": "Content",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": false,
      "format": "OAuth client identifier registered by Auth",
      "example": "realm-content-reader",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Server-only Realm client for protected Content reads.",
      "failureBehavior": "Protected Content reads fail closed when absent."
    },
    {
      "key": "CONTENT_SERVICE_CLIENT_SECRET",
      "section": "Content",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "OAuth client secret registered by Auth",
      "example": "replace-with-a-long-random-secret",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/content-api.ts"],
      "description": "Server-only credential paired with CONTENT_SERVICE_CLIENT_ID.",
      "failureBehavior": "Protected Content reads fail closed; never expose the value to the browser."
    },
    {
      "key": "ACCESS_GRANT_SECRET",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "long random server-side signing secret",
      "example": "replace-with-a-random-long-string",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/access-grant.ts"],
      "description": "Signs the protected-post access grant cookie.",
      "failureBehavior": "Grant creation and verification fail closed."
    },
    {
      "key": "TOTP_GROUPS_JSON",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "JSON object map with current base32 secret and optional period/digits/window",
      "example": "{\"friends-a\":{\"current\":\"JBSWY3DPEHPK3PXP\",\"period\":30,\"digits\":6,\"window\":1}}",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/totp.ts"],
      "description": "Server-only TOTP group configuration for protected posts.",
      "failureBehavior": "Invalid JSON is rejected; an unset map provides no configured groups."
    },
    {
      "key": "REVALIDATE_WEBHOOK_SECRET",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "long random HMAC secret shared with API and asset publisher",
      "example": "replace-with-a-long-random-secret",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": [
        "src/features/content/server/internalRevalidateHandler.ts",
        "scripts/assets/publish.mjs"
      ],
      "description": "Authenticates internal Content and asset revalidation events.",
      "failureBehavior": "Unsigned, stale, or incorrectly signed events are rejected."
    },
    {
      "key": "TRUST_PROXY",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "boolean string: 1/0 or true/false",
      "example": "1",
      "localDefault": "",
      "scopes": ["local", "self-hosted"],
      "usedBy": ["src/shared/server/http.ts"],
      "description": "Trusts forwarded client-IP headers behind a controlled reverse proxy.",
      "failureBehavior": "Defaults to untrusted headers; Vercel is recognized by platform context."
    },
    {
      "key": "VISITOR_STATS_SECRET",
      "section": "Security",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "long random HMAC secret unique to Realm visitor statistics",
      "example": "replace-with-a-random-long-string",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/features/visitor-stats/server/visitorStats.ts"],
      "description": "Signs anonymous visitor-statistics cookies and database writes.",
      "failureBehavior": "Visitor-statistics persistence is skipped when the secret is absent."
    },
    {
      "key": "DATABASE_URL",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "PostgreSQL connection URL, with TLS required for hosted databases",
      "example": "postgresql://user:password@host/database?sslmode=require",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": [
        "src/features/visitor-stats/server/visitorStats.ts",
        "scripts/visitor-stats-migrate.mjs",
        "scripts/visitor-stats-seed.mjs"
      ],
      "description": "Realm visitor-statistics database connection.",
      "failureBehavior": "Visitor-statistics persistence and database commands fail closed."
    },
    {
      "key": "UPSTASH_REDIS_REST_URL",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "absolute HTTPS Upstash REST URL",
      "example": "https://xxx.upstash.io",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/rate-limit.ts"],
      "description": "Distributed rate-limit store endpoint.",
      "failureBehavior": "The limiter uses a process-local Map."
    },
    {
      "key": "UPSTASH_REDIS_REST_TOKEN",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": true,
      "format": "Upstash REST bearer token paired with the REST URL",
      "example": "your-token",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/shared/lib/content/rate-limit.ts"],
      "description": "Distributed rate-limit store credential.",
      "failureBehavior": "The limiter uses a process-local Map."
    },
    {
      "key": "COS_PRIVATE_BUCKET",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "COS bucket name without protocol or slash",
      "example": "your-private-bucket",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": [
        "src/features/assets/server/catalog/catalog-provider.ts",
        "scripts/assets/publish.mjs"
      ],
      "description": "Private bucket for server-side versioned Catalog and asset publication.",
      "failureBehavior": "Private Catalog reads return the configured unavailable/fallback result."
    },
    {
      "key": "COS_PRIVATE_REGION",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": false,
      "format": "Tencent COS region identifier",
      "example": "ap-hongkong",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": [
        "src/features/assets/server/catalog/catalog-provider.ts",
        "scripts/assets/publish.mjs"
      ],
      "description": "Region for the private Catalog bucket.",
      "failureBehavior": "The private COS client is not created."
    },
    {
      "key": "COS_PUBLIC_BUCKET",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "COS bucket name without protocol or slash",
      "example": "your-public-bucket",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["scripts/assets/publish.mjs"],
      "description": "Public-media bucket target for the asset publisher.",
      "failureBehavior": "Asset publication refuses to start."
    },
    {
      "key": "COS_PUBLIC_REGION",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": false,
      "format": "Tencent COS region identifier",
      "example": "ap-hongkong",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["scripts/assets/publish.mjs"],
      "description": "Region for the public-media bucket.",
      "failureBehavior": "Asset publication refuses to start."
    },
    {
      "key": "COS_SECRET_ID",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "Tencent Cloud CAM SecretId",
      "example": "AKIDxxx",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": [
        "src/features/assets/server/catalog/catalog-provider.ts",
        "scripts/assets/publish.mjs"
      ],
      "description": "Server-side COS/COSCLI credential identifier.",
      "failureBehavior": "COS reads or publication refuse to start."
    },
    {
      "key": "COS_SECRET_KEY",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "conditional",
      "secret": true,
      "format": "Tencent Cloud CAM SecretKey",
      "example": "xxxx",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": [
        "src/features/assets/server/catalog/catalog-provider.ts",
        "scripts/assets/publish.mjs"
      ],
      "description": "Server-side COS/COSCLI credential secret.",
      "failureBehavior": "COS reads or publication refuse to start."
    },
    {
      "key": "COS_PRIVATE_CATALOG_PREFIX",
      "section": "Infra",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "relative object-key prefix without leading/trailing slash",
      "example": "",
      "localDefault": "",
      "scopes": ["local", "preview", "production"],
      "usedBy": ["src/features/assets/server/catalog/catalog-provider.ts"],
      "description": "Optional prefix before the Realm private Catalog namespace.",
      "failureBehavior": "Catalog keys use the realm/catalog namespace directly."
    },
    {
      "key": "TWEETS_STRESS_TEST",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "feature flag: 1 enables synthetic development data",
      "example": "1",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Enables synthetic Tweet archive data for development.",
      "failureBehavior": "Real published Content data is used."
    },
    {
      "key": "TWEETS_STRESS_YEARS",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "positive decimal integer",
      "example": "6",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Synthetic archive year count when stress mode is enabled.",
      "failureBehavior": "Defaults to 6."
    },
    {
      "key": "TWEETS_STRESS_MONTHS_PER_YEAR",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "positive decimal integer",
      "example": "12",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Synthetic archive months per year when stress mode is enabled.",
      "failureBehavior": "Defaults to 12."
    },
    {
      "key": "TWEETS_STRESS_TWEETS_PER_MONTH",
      "section": "Tweets Dev",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "positive decimal integer",
      "example": "24",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["src/features/tweets/server/content.ts"],
      "description": "Synthetic Tweet count per month when stress mode is enabled.",
      "failureBehavior": "Defaults to 24."
    },
    {
      "key": "ANALYZE",
      "section": "Advanced",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "literal true to enable bundle analyzer",
      "example": "true",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["next.config.js"],
      "description": "Enables the Next.js bundle analyzer for a local build.",
      "failureBehavior": "The analyzer remains disabled."
    },
    {
      "key": "NEXT_BUILD_DIR",
      "section": "Advanced",
      "exampleFiles": [".env.example"],
      "commented": true,
      "requiredness": "optional",
      "secret": false,
      "format": "relative build directory path",
      "example": ".next",
      "localDefault": "",
      "scopes": ["local", "self-hosted"],
      "usedBy": ["next.config.js"],
      "description": "Optional Next.js build output directory.",
      "failureBehavior": "Uses .next."
    },
    {
      "key": "COS_SESSION_TOKEN",
      "section": "Asset Publisher",
      "exampleFiles": [],
      "commented": false,
      "requiredness": "optional",
      "secret": true,
      "format": "temporary Tencent Cloud session token",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["scripts/assets/publish.mjs"],
      "description": "Optional token paired with temporary COS credentials.",
      "failureBehavior": "The publisher uses the long-lived credential pair."
    },
    {
      "key": "COSCLI_PATH",
      "section": "Asset Publisher",
      "exampleFiles": [],
      "commented": false,
      "requiredness": "optional",
      "secret": false,
      "format": "absolute or repository-relative executable path",
      "localDefault": "",
      "scopes": ["local"],
      "usedBy": ["scripts/assets/publish.mjs"],
      "description": "Optional COSCLI executable override.",
      "failureBehavior": "Uses cos-workspace/coscli-windows-amd64.exe."
    },
    {
      "key": "COS_PRIVATE_LOCAL_ROOT",
      "section": "Test Provider Input",
      "exampleFiles": [],
      "commented": false,
      "requiredness": "optional",
      "secret": false,
      "format": "repository-relative test fixture directory",
      "localDefault": "",
      "scopes": ["test"],
      "usedBy": ["src/features/assets/server/catalog/catalog-provider.ts"],
      "description": "Test-only local Catalog root used to exercise remote-to-local fallback.",
      "failureBehavior": "Tests use the generated dist/cos-upload/private-root default."
    }
  ]
}
