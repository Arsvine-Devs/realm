{
  "name": "arsvine-realm",
  "version": "2.0.5",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "oxlint -c config/oxlint.json . && eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path config/prettier.ignore --log-level warn",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path config/prettier.ignore --log-level warn",
    "check:unused": "knip --config config/knip.jsonc --no-progress",
    "check:duplicates": "jscpd --config config/jscpd.json",
    "quality": "pnpm check:unused && pnpm check:duplicates",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:check": "node scripts/check-doc-links.mjs",
    "envctl": "node scripts/env.mjs",
    "env:check": "node scripts/check-env-contract.mjs",
    "assets:prepare-legacy": "node scripts/assets/prepare-legacy.mjs",
    "assets:build": "node scripts/assets/build.mjs",
    "assets:publish": "node scripts/assets/publish.mjs",
    "db:migrate": "node scripts/visitor-stats-migrate.mjs",
    "db:seed:visitor-stats": "node scripts/visitor-stats-seed.mjs",
    "env:sync": "node scripts/sync-env-files.mjs",
    "maintenance:check": "node scripts/fetch-google-fonts.mjs --check-config && pnpm docs:check",
    "check": "pnpm format:check && pnpm maintenance:check && pnpm env:check && pnpm lint && pnpm typecheck && pnpm quality && pnpm test && pnpm build"
  },
  "prettier": "./config/prettier.json",
  "keywords": [],
  "author": "Arsvine Zhu",
  "license": "MIT",
  "description": "A post-apocalyptic HUD-themed portfolio & blog template built with Next.js 16",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/cannon": "^6.6.0",
    "@react-three/fiber": "9.7.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.1",
    "@vercel/speed-insights": "^2.1.0",
    "@xstate/react": "^6.1.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "next-intl": "^4.14.10",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "three": "^0.187.0",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-oxlint": "1.93.0",
    "jscpd": "5.4.3",
    "jsdom": "^30.0.1",
    "knip": "6.45.0",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
