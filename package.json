{
  "name": "arsvine-realm",
  "version": "2.0.1",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:prepare": "node scripts/prepare-cos-workspace.mjs",
    "assets:build": "node scripts/assets-build.mjs",
    "assets:publish": "node scripts/assets-publish.mjs",
    "env:sync": "node scripts/sync-env-files.mjs",
    "maintenance:check": "node scripts/fetch-google-fonts.mjs --check-config",
    "check": "node scripts/fetch-google-fonts.mjs --check-config && eslint . && tsc --noEmit && vitest run && next build"
  },
  "keywords": [],
  "author": "Arsvine Zhu",
  "license": "MIT",
  "description": "A post-apocalyptic HUD-themed portfolio & blog template built with Next.js 16",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@react-three/cannon": "^6.6.0",
    "@react-three/fiber": "9.6.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.0",
    "@vercel/speed-insights": "^2.0.0",
    "@xstate/react": "^6.1.0",
    "cannon-es": "^0.20.0",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.13.0",
    "next": "^16.2.11",
    "next-intl": "^4.13.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.72.0",
    "three": "^0.185.1",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
