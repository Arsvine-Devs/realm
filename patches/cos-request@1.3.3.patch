+// Node 24 deprecates the legacy url.parse() API. Keep the legacy request
+// object fields that this package consumes while parsing absolute URLs with
+// the WHATWG URL implementation.
+function parseRequestUrl (value) {
+  if (typeof value !== 'string') {
+    return value
+  }
+
+  try {
+    var parsed = new url.URL(value)
+    parsed.query = parsed.search ? parsed.search.slice(1) : null
+    parsed.path = parsed.pathname + (parsed.search || '')
+    if (parsed.username || parsed.password) {
+      parsed.auth = decodeURIComponent(parsed.username) + ':' + decodeURIComponent(parsed.password)
+    }
+    return parsed
+  } catch (error) {
+    // Preserve request's invalid/relative URL error path without invoking the
+    // deprecated parser. COS SDK requests use absolute URLs.
+    var hashIndex = value.indexOf('#')
+    var withoutHash = hashIndex === -1 ? value : value.slice(0, hashIndex)
+    var queryIndex = withoutHash.indexOf('?')
+    var pathname = queryIndex === -1 ? withoutHash : withoutHash.slice(0, queryIndex)
+    var search = queryIndex === -1 ? null : withoutHash.slice(queryIndex)
+    var hash = hashIndex === -1 ? null : value.slice(hashIndex)
+
+    return {
+      protocol: null,
+      slashes: null,
+      auth: null,
+      host: null,
+      port: null,
+      hostname: null,
+      hash: hash,
+      search: search,
+      query: search ? search.slice(1) : null,
+      pathname: pathname,
+      path: pathname + (search || ''),
+      href: value
+    }
+  }
+}
